[Unit]
Description=Confido evidence collector
After=network-online.target
Wants=network-online.target
Before=nginx.service

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/bin/confido-server 127.0.0.1:8001 /etc/confido sha256 --tls-hostname match.demo.genxt.network
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/confido

[Install]
WantedBy=multi-user.target
